<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <id>ai.storyteller.figcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>FigCraft</name>
  <summary>Design and prototype user interfaces</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      FigCraft is an open-source, native interface design and prototyping tool. Lay out screens
      on an infinite canvas with frames, auto layout and constraints, build reusable components
      and variants, and link screens into clickable prototypes.
    </p>
    <ul>
      <li>Frames, vector shapes, text and images on an infinite canvas</li>
      <li>Auto layout and constraints for responsive designs</li>
      <li>Components, variants, shared styles and variables</li>
      <li>Prototyping with interactions and transitions, and a presentation mode</li>
      <li>Inspect panel with measurements and code snippets; SVG and PNG export</li>
      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.figcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.figcraft</icon>
  <url type="homepage">https://getartcraft.com/apps/figcraft</url>
