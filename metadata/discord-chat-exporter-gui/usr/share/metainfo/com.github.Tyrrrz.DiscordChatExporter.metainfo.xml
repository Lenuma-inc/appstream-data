<component type="desktop-application">
  <id>com.github.Tyrrrz.DiscordChatExporter</id>
  <name>Discord Chat Exporter</name>
  <summary>Export Discord channel message history</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <url type="homepage">https://github.com/Tyrrrz/DiscordChatExporter</url>
  <launchable type="desktop-id">discord-chat-exporter-gui.desktop</launchable>
  <icon type="stock">discord-chat-exporter-gui</icon>
  <description>
    <p>Discord Chat Exporter saves message history from Discord channels to files. It supports direct messages, group conversations and server channels, preserving message formatting and rich media in supported export formats.</p>
    <p>The graphical interface lets you choose channels and configure an export. Exported conversations can be viewed independently of the Discord client.</p>
  </description>
