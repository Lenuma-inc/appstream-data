<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <id>ai.storyteller.pdfcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>PdfCraft</name>
  <summary>Read, organize, combine, split and secure PDFs</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      PdfCraft is an open-source PDF workbench. Read, comment on, fill in and sign PDFs;
      organize, combine and split pages; edit, redact, protect and export documents.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.pdfcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.pdfcraft</icon>
  <url type="homepage">https://getartcraft.com/apps/pdfcraft</url>
  <url type="bugtracker">https://github.com/storytold/pdfcraft/issues</url>
  <url type="help">https://github.com/storytold/pdfcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Office</category>
    <category>Viewer</category>
  </categories>
  <keywords>
    <keyword>pdf</keyword>
    <keyword>viewer</keyword>
    <keyword>annotate</keyword>
    <keyword>forms</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>A PDF open with its threaded comments</caption>
      <image>https://raw.githubusercontent.com/storytold/pdfcraft/86730ed14466c5388173e32ef5a3ec015e523b9a/docs/images/pdfcraft-viewer.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>pdfcraft</binary>
    <mediatype>application/pdf</mediatype>
  </provides>
  <content_rating type="oars-1.1" />
</component>
